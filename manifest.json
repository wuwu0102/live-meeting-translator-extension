{
  "manifest_version": 3,
  "name": "Live Meeting Translator",
  "version": "1.0.0",
  "description": "Chrome extension for live meeting audio translation subtitles",
  "permissions": ["tabCapture", "activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
