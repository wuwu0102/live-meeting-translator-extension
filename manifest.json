{
  "manifest_version": 3,
  "name": "Live Meeting Translator",
  "version": "2.0.0",
  "description": "Chrome extension for real-time bilingual meeting subtitles using Google Speech-to-Text and Google Translate",
  "permissions": [
    "tabCapture",
    "activeTab",
    "storage",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://speech.googleapis.com/*",
    "https://translation.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
